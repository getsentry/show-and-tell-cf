{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "show-and-tell-cf",
  "account_id": "20d94f53c7cab0b469521b703ff1923c",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "show-and-tell-db",
      "database_id": "872dd445-f761-48b8-a17b-70288f862548",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://showandtell.sentry.new",
    "GOOGLE_REDIRECT_URI": "https://showandtell.sentry.new/api/auth/callback",
    "GOOGLE_CLIENT_ID": "931381634032-ekdlv1qv93lmhimm8l3l7kknvvd9sitk.apps.googleusercontent.com",
    "ALLOWED_EMAIL_DOMAIN": "sentry.io",
    "VIDEO_PROCESSOR_CONCURRENCY": "1",
    "VIDEO_PROCESSING_AUTOSTART": "true",
    "SHOW_REMINDERS_ENABLED": "false",
    "SHOW_EMAIL_FROM": {"email": "junior@sentry.new", "name": "Jr."}
  },
  "send_email": [
    {
      "name": "SHOW_EMAIL",
      "allowed_sender_addresses": ["junior@sentry.new"],
      "allowed_destination_addresses": [
        "team@sentry.io",
        "sergiy.dybskiy@sentry.io",
        "dgriesser@sentry.io"
      ]
    }
  ],
  "routes": [
    {"pattern": "showandtell.sentry.new", "custom_domain": true},
    {"pattern": "showntell.sentry.new", "custom_domain": true}
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "show-and-tell-videos-production"
    }
  ],
  "workflows": [
    {
      "binding": "VIDEO_PROCESSING_WORKFLOW",
      "name": "show-and-tell-video-processing-production",
      "class_name": "VideoProcessingWorkflow"
    }
  ],
  "containers": [
    {
      "name": "show-and-tell-video-processor-production",
      "class_name": "VideoProcessorContainer",
      "image": "./Dockerfile.video-processor",
      "image_build_context": ".",
      "max_instances": 2,
      "instance_type": "standard-2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VIDEO_PROCESSOR",
        "class_name": "VideoProcessorContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "video-processor-v1",
      "new_sqlite_classes": ["VideoProcessorContainer"]
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
