{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "show-and-tell-cf",
  "account_id": "20d94f53c7cab0b469521b703ff1923c",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "show-and-tell-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://showntell.sentry.new",
    "GOOGLE_REDIRECT_URI": "https://showntell.sentry.new/api/auth/callback",
    "GOOGLE_CLIENT_ID": "configure-me.apps.googleusercontent.com",
    "ALLOWED_EMAIL_DOMAIN": "sentry.io"
  },
  "observability": {"enabled": true}
}
