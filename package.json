{
  "name": "show-and-tell-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && vp dev",
    "start": "vp dev",
    "typecheck": "tsc -b",
    "format:check": "vp fmt --check .",
    "lint": "vp lint src test vite.config.ts vitest.config.ts --deny-warnings",
    "test": "npm run test:app && npm run test:worker",
    "verify": "npm run cf-typegen && npm run typecheck && npm run format:check && npm run lint && npm test && npm run build && npm run deploy:dry-run",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.production.json --outdir .wrangler/deploy-dry-run",
    "build": "vp build",
    "preview": "vp preview",
    "cf-typegen": "wrangler types worker-configuration.d.ts --config wrangler.production.json",
    "db:migrate:local": "wrangler d1 migrations apply show-and-tell-db --local",
    "test:app": "vp test run",
    "test:worker": "vp test run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.3.0",
    "hono": "^4.13.5",
    "jose": "^6.2.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@oxlint/plugins": "1.78.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^26.1.0",
    "oxlint": "1.78.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plus": "0.2.7",
    "vitest": "4.1.10",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "@oxlint/plugins": "$@oxlint/plugins",
    "oxlint": "$oxlint"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "volta": {
    "node": "24.19.0"
  }
}
